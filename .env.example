# PPRO Ordinace Na Vyhlídce - Konfigurace prostředí (Environment Variables)

# Databáze (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/ordinace_db

# Bezpečnost a JWT
# Vlastní náhodný řetězec (např. python -c "import secrets; print(secrets.token_urlsafe(48))").
# Prázdné = aplikace si klíč vygeneruje při startu (po restartu je nutné se znovu přihlásit).
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Výchozí administrátor pro první seed (syntetický demo účet – v reálném nasazení změňte)
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=Admin123!
FIRST_ADMIN_EMAIL=admin@ordinacenavyhlidce.cz
FIRST_ADMIN_FULL_NAME=Administrátor Systému

# Údaje ordinace v hlavičce měsíčního výkazu (syntetické)
PRACTICE_NAME=Ordinace Na Vyhlídce s.r.o.
PRACTICE_ADDRESS=Na Vyhlídce 12, 500 03 Hradec Králové
PRACTICE_ICZ=52999000
